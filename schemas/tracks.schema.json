{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kajisho5/detection-skill/schemas/tracks.schema.json",
  "title": "Tracks",
  "description": "detection-skill/tracks@1. Boxes of a detections document linked over time by a documented heuristic (greedy IoU, centre-distance fallback), with redact-ready rectangles for ffmpeg-skill redact. A track id is not an identity. The validator in src/detection_skill/tracks.py is the executable form.",
  "type": "object",
  "required": ["schema", "kind", "source", "frame_size", "detections", "method", "parameters", "tracks", "counts", "skill",
               "skill_version", "tool", "created_at", "processing_seconds", "warnings"],
  "properties": {
    "schema": {"const": "detection-skill/tracks@1"},
    "kind": {"enum": ["face", "text", "object"]},
    "source": {"type": "object", "description": "copied from the detections document"},
    "frame_size": {"type": "object", "required": ["width", "height"]},
    "detections": {
      "type": "object",
      "required": ["file", "fingerprint", "tool", "engine", "model", "model_sha256", "sampling_method", "sampling_step"],
      "properties": {"file": {"type": ["string", "null"]}, "fingerprint": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}}
    },
    "method": {
      "type": "object", "required": ["name", "heuristic", "identity", "note"],
      "properties": {"name": {"const": "greedy-iou"}, "heuristic": {"const": true}, "identity": {"const": false}, "note": {"type": "string"}}
    },
    "parameters": {
      "type": "object", "required": ["min_iou", "max_shift", "max_gap", "pad", "extend", "window", "min_hits", "same_label"],
      "properties": {"min_iou": {"type": "number"}, "max_shift": {"type": "number"}, "max_gap": {"type": "number"}, "pad": {"type": "number"}, "extend": {"type": "number"},
                     "window": {"type": "number"}, "min_hits": {"type": "integer"}, "same_label": {"type": "boolean"}}
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "start", "end", "hits", "mean_score", "max_score", "boxes", "redact"],
        "properties": {
          "id": {"type": "string", "pattern": "^track_\\d{3,}$"},
          "label": {"type": ["string", "null"], "description": "face: null; object: the class; text: the most frequent OCR text"},
          "start": {"type": "number"}, "end": {"type": "number"}, "hits": {"type": "integer", "minimum": 1},
          "mean_score": {"type": "number"}, "max_score": {"type": "number"},
          "boxes": {"type": "array", "minItems": 1,
                    "items": {"type": "object", "required": ["t", "box", "score"],
                              "properties": {"t": {"type": "number"}, "box": {"type": "array", "minItems": 4, "maxItems": 4}, "score": {"type": "number"}}}},
          "redact": {"type": "array", "minItems": 1,
                     "items": {"type": "object", "required": ["start", "end", "x", "y", "width", "height"],
                               "properties": {"start": {"type": "number"}, "end": {"type": "number"},
                                              "x": {"type": "integer", "minimum": 0}, "y": {"type": "integer", "minimum": 0},
                                              "width": {"type": "integer", "minimum": 2, "multipleOf": 2},
                                              "height": {"type": "integer", "minimum": 2, "multipleOf": 2}}}}
        }
      }
    },
    "counts": {"type": "object", "required": ["tracks", "boxes_linked", "boxes_dropped", "redact_rects"]},
    "skill": {"const": "detection-skill"},
    "skill_version": {"type": "string"},
    "tool": {"const": "detection/tracks"},
    "created_at": {"type": "string"},
    "processing_seconds": {"type": "number", "minimum": 0},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
